# Thread RCP (Spinel over CPC) + Bluetooth controller (HCI over CPC) on one radio.
# Derived from the SDK 2025.6.3 recipe protocol/openthread/sample-apps/ot-ncp/rcp-uart-802154-blehci.slcp
# ("Multiprotocol (OpenThread+Zigbee+BLE) - RCP (UART)", quality production). Changes, and why:
#   - CPC security off (cpc_security_secondary_none): our host has no CPC security; the link is a
#     local USB cable. Without this component cpc_secondary pulls security in (see zigbee-ble befbdeb).
#   - Multipan (CMP) off: one 802.15.4 host only (otbr-agent). A multipan RCP reserves Spinel IID 0
#     for broadcast and has no instance behind it (ncp_base.cpp NcpBase(Instance **, ...)), so a
#     standard otbr-agent build (IID 0) could not drive it. Off, the 802.15.4 side is the same
#     single-instance RCP that runs in production over HDLC, carried over CPC endpoint 12 instead.
#   - UART 460800 baud, no hardware flow control: the board has no CTS/RTS (board/dongle-pmg24.md).
#     Board pins and crystal are applied after generation by thread-ble/apply-board.py.
#   - Series 3 (EUSART) alternatives dropped: the EFR32MG24 is series 2.
project_name: thread-ble-hci
label: Thread RCP + Bluetooth HCI (CPC, UART)
package: openthread
description: >
  OpenThread radio co-processor (Spinel) and Bluetooth controller (HCI) over CPC on one UART,
  dynamic multiprotocol, single 802.15.4 instance.
category: OpenThread Examples
quality: experimental
author: infra/ha

component:
  - id: sl_main
  - id: ot_crash_handler
  - id: ot_stack_rcp
  - id: ot_ncp_cpc
  - id: cpc_secondary_driver_uart_usart
    instance: [vcom]
  - id: cpc_secondary
  # cpc_secondary pulls in cpc_security_secondary unless this is selected
  - id: cpc_security_secondary_none
  - id: rail_util_pti
  - id: bootloader_interface
  - id: freertos
  - id: freertos_heap_3
  - id: bluetooth_hci_cpc
  - id: bluetooth_controller
  - id: bluetooth_feature_connection_role_central
  - id: bluetooth_feature_connection_role_peripheral
  - id: bluetooth_feature_advertiser
  - id: bluetooth_feature_connection_phy_update
  - id: bluetooth_feature_legacy_scanner
  - id: bluetooth_feature_extended_scanner
  - id: bluetooth_feature_extended_advertiser
  - id: rail_lib_multiprotocol
  - id: clock_manager
  - id: ot_diags
  - id: ot_reset_utils
  # Platform - Enable LTO for gcc by installing the following component
  - id: toolchain_gcc_lto

include:
  - path: .
    file_list:
    - path: app.h

source:
  - path: app.c

configuration:
  - name: SL_BT_CONFIG_USER_ADVERTISERS
    value: 3
  - name: SL_MAIN_START_TASK_STACK_SIZE_BYTES
    value: 2752
    condition: [sl_main]
  - name: SL_STACK_SIZE
    value: 2752
  - name: SL_HEAP_SIZE
    value: "15700"
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: SL_CPC_DRV_UART_VCOM_BAUDRATE
    value: 460800
  - name: SL_CPC_DRV_UART_VCOM_FLOW_CONTROL_TYPE
    value: usartHwFlowControlNone
  - name: OPENTHREAD_CONFIG_HEAP_EXTERNAL_ENABLE
    value: 0
  - name: OPENTHREAD_CONFIG_LOG_OUTPUT
    value: OPENTHREAD_CONFIG_LOG_OUTPUT_NONE
  - name: OPENTHREAD_CONFIG_MULTIPAN_RCP_ENABLE
    value: 0
  - name: OPENTHREAD_CONFIG_MULTIPLE_INSTANCE_ENABLE
    value: 0
  - name: OPENTHREAD_CONFIG_MULTIPLE_STATIC_INSTANCE_ENABLE
    value: 0
  - name: OPENTHREAD_CONFIG_PLATFORM_KEY_REFERENCES_ENABLE
    value: 0
  - name: OPENTHREAD_CONFIG_MAC_CSL_RECEIVER_ENABLE
    value: 0
  - name: OPENTHREAD_CONFIG_MAC_CSL_AUTO_SYNC_ENABLE
    value: 0
  - name: SL_CPC_RX_BUFFER_MAX_COUNT
    value: 15
  - name: SL_CPC_TX_QUEUE_ITEM_MAX_COUNT
    value: 15
  - name: CIRCULAR_QUEUE_LEN_MAX
    value: 16
  - name: SL_OPENTHREAD_STACK_TASK_MEM_SIZE
    value: 4608

template_contribution:
  - name: component_catalog
    value: bluetooth_ncp
