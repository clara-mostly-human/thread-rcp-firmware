# Large third-party archives and their unpacked trees live on disk but not in git;
# vendor/SHA256SUMS (tracked) pins exactly which files they are.
vendor/*.zip
vendor/*.tar.xz
vendor/unpacked/
build/
out/*.s37
out/*.hex
out/*.map
firmware/build/
# a symlink to the main checkout's vendor/unpacked in a worktree
vendor/unpacked
vendor/*.tar.gz
# Images are published as release assets (with their SHA-256), not committed.
out/*.gbl
