<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- ASH bridge for ZHA: owns the zigbee-ble dongle over CPC, serves ASH on 127.0.0.1:6638.
       Interim service until it becomes a native app in ha-macos-apps. Label outside the
       Supervisor's ha-macos.* namespace on purpose. -->
  <key>Label</key><string>local.zigbee-ble-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/me/Projects/thread-rcp-firmware/zigbee-ble/host/.venv/bin/python</string>
    <string>/Users/me/Projects/thread-rcp-firmware/zigbee-ble/host/ash_bridge.py</string>
    <string>/Users/me/Projects/infra/ha/supervisor/data/dev/serial/by-id/usb-SONOFF_SONOFF_Dongle_Plus_MG24_00000000000000000000000000000000-if00-port0</string>
    <string>--port</string><string>6638</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/me/Projects/thread-rcp-firmware/zigbee-ble/host</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>/Users/me/Projects/infra/ha/logs/zigbee-ble-bridge.log</string>
  <key>StandardErrorPath</key><string>/Users/me/Projects/infra/ha/logs/zigbee-ble-bridge.log</string>
</dict>
</plist>
