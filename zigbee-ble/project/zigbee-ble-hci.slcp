# Zigbee NCP + Bluetooth controller (HCI) over CPC on one radio (dynamic multiprotocol).
# Derived from the SDK 2025.6.3 recipe protocol/zigbee/app/projects/ncp/ncp-dmp/zigbee_ncp-ble_ncp-uart.slcp
# (Zigbee NCP + Bluetooth NCP, quality experimental): the Zigbee half is unchanged; the Bluetooth
# NCP (BGAPI, host stack on the chip) is replaced by the Bluetooth controller with standard HCI over
# CPC, as in protocol/openthread/sample-apps/ot-ncp/rcp-uart-802154-blehci.slcp. CPC security off.
# Board: SONOFF Dongle Plus MG24 (see ../../board/dongle-pmg24.md); pins and crystal are set after generation.
project_name: zigbee-ble-hci
label: Zigbee NCP + Bluetooth HCI (CPC, UART)
package: multiprotocol
category: Zigbee + Bluetooth NCP Application
quality: experimental
description: Zigbee NCP and Bluetooth controller (HCI) over CPC on one UART, dynamic multiprotocol.
author: infra/ha
component:
  - id: sl_main
  - id: cpc_secondary_driver_uart_usart
    instance: [vcom]
  - id: zigbee_debug_basic
  - id: zigbee_debug_print
  - id: common_token_manager
  - id: zigbee_pro_stack
  - id: zigbee_source_route
  - id: zigbee_gp
  - id: zigbee_r22_support
  - id: zigbee_security_link_keys
  - id: zigbee_zll
  - id: zigbee_system_common
  - id: zigbee_ncp_cpc
  - id: bluetooth_hci_cpc
  - id: bluetooth_controller
  - id: bluetooth_feature_connection_role_central
  - id: bluetooth_feature_connection_role_peripheral
  - id: bluetooth_feature_advertiser
  - id: bluetooth_feature_connection_phy_update
  - id: bluetooth_feature_legacy_scanner
  - id: bluetooth_feature_extended_scanner
  - id: bluetooth_feature_extended_advertiser
  - id: rail_lib_multiprotocol
  - id: freertos
  - id: freertos_heap_3
  - id: toolchain_gcc
  - id: cpc_secondary
  - id: rail_util_pti
  - id: rail_util_coex
  - id: bootloader_interface
  - id: clock_manager
configuration:
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: SL_CPC_DRV_UART_VCOM_BAUDRATE
    value: 460800
  - name: SL_CPC_DRV_UART_VCOM_FLOW_CONTROL_TYPE
    value: usartHwFlowControlNone
  - name: SL_ZIGBEE_BINDING_TABLE_SIZE
    value: 32
  - name: SL_ZIGBEE_MAX_END_DEVICE_CHILDREN
    value: 32
  - name: SL_ZIGBEE_PACKET_BUFFER_HEAP_SIZE
    value: SL_ZIGBEE_LARGE_PACKET_BUFFER_HEAP
  - name: EMBER_AF_PLUGIN_ZIGBEE_PRO_STACK_CHILD_TABLE_SIZE
    value: 32
  - name: SL_ZIGBEE_KEY_TABLE_SIZE
    value: 12
  - name: SL_ZIGBEE_OS_STACK_TASK_PRIORITY
    value: osPriorityNormal1
  - name: NVM3_DEFAULT_NVM_SIZE
    value: 32768
    condition:
      - device_series_2
  - name: SL_PSA_ITS_SUPPORT_V1_DRIVER
    value: 0
  - name: SL_PSA_ITS_SUPPORT_V2_DRIVER
    value: 0
  - name: SL_PSA_ITS_SUPPORT_V3_DRIVER
    value: 1
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: 0
    condition:
      - psa_crypto
  - name: SL_LEGACY_HAL_WDOG_PERIOD
    value: wdogPeriod_256k
  - name: LIB_MEM_CFG_HEAP_SIZE
    value: 0
  - name: SL_BT_CONFIG_USER_ADVERTISERS
    value: 1
  - name: SL_STACK_SIZE
    value: 4096
    condition:
      - freertos
  - name: configTIMER_TASK_PRIORITY
    value: 53
  - name: configMAX_TASK_NAME_LEN
    value: 30
source:
  - path: main.c
    unless: [cmsis_rtos2]
  - path: app.c
define:
  - name: SL_ZIGBEE_CUSTOM_MAC_FILTER_TABLE_SIZE
    value: 15
