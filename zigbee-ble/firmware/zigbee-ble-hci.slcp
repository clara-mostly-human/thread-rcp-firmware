# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: zigbee-ble-hci
label: Zigbee NCP + Bluetooth HCI (CPC, UART)
author: infra/ha
description: Zigbee NCP and Bluetooth controller (HCI) over CPC on one UART, dynamic
  multiprotocol.
category: Zigbee + Bluetooth NCP Application
package: multiprotocol
quality: experimental
source:
- {path: app.c}
sdk: {id: simplicity_sdk, version: 2025.6.3}
toolchain_settings: []
component:
- {id: EFR32MG24A020F1024IM40}
- {id: bluetooth_controller}
- {id: bluetooth_feature_advertiser}
- {id: bluetooth_feature_connection_phy_update}
- {id: bluetooth_feature_connection_role_central}
- {id: bluetooth_feature_connection_role_peripheral}
- {id: bluetooth_feature_extended_advertiser}
- {id: bluetooth_feature_extended_scanner}
- {id: bluetooth_feature_legacy_scanner}
- {id: bluetooth_hci_cpc}
- {id: bootloader_interface}
- {id: clock_manager}
- {id: common_token_manager}
- {id: cpc_secondary}
- instance: [vcom]
  id: cpc_secondary_driver_uart_usart
- {id: freertos}
- {id: freertos_heap_3}
- {id: rail_lib_multiprotocol}
- {id: rail_util_coex}
- {id: rail_util_pti}
- {id: sl_main}
- {id: toolchain_gcc}
- {id: zigbee_debug_basic}
- {id: zigbee_debug_print}
- {id: zigbee_gp}
- {id: zigbee_ncp_cpc}
- {id: zigbee_pro_stack}
- {id: zigbee_r22_support}
- {id: zigbee_security_link_keys}
- {id: zigbee_source_route}
- {id: zigbee_system_common}
- {id: zigbee_zll}
define:
- {name: SL_ZIGBEE_CUSTOM_MAC_FILTER_TABLE_SIZE, value: '15'}
configuration:
- {name: SL_BOARD_ENABLE_VCOM, value: '1'}
- {name: SL_CPC_DRV_UART_VCOM_BAUDRATE, value: '460800'}
- {name: SL_CPC_DRV_UART_VCOM_FLOW_CONTROL_TYPE, value: usartHwFlowControlNone}
- {name: SL_ZIGBEE_BINDING_TABLE_SIZE, value: '32'}
- {name: SL_ZIGBEE_MAX_END_DEVICE_CHILDREN, value: '32'}
- {name: SL_ZIGBEE_PACKET_BUFFER_HEAP_SIZE, value: SL_ZIGBEE_LARGE_PACKET_BUFFER_HEAP}
- {name: EMBER_AF_PLUGIN_ZIGBEE_PRO_STACK_CHILD_TABLE_SIZE, value: '32'}
- {name: SL_ZIGBEE_KEY_TABLE_SIZE, value: '12'}
- {name: SL_ZIGBEE_OS_STACK_TASK_PRIORITY, value: osPriorityNormal1}
- condition: [device_series_2]
  name: NVM3_DEFAULT_NVM_SIZE
  value: '32768'
- {name: SL_PSA_ITS_SUPPORT_V1_DRIVER, value: '0'}
- {name: SL_PSA_ITS_SUPPORT_V2_DRIVER, value: '0'}
- {name: SL_PSA_ITS_SUPPORT_V3_DRIVER, value: '1'}
- condition: [psa_crypto]
  name: SL_PSA_KEY_USER_SLOT_COUNT
  value: '0'
- {name: SL_LEGACY_HAL_WDOG_PERIOD, value: wdogPeriod_256k}
- {name: LIB_MEM_CFG_HEAP_SIZE, value: '0'}
- {name: SL_BT_CONFIG_USER_ADVERTISERS, value: '1'}
- condition: [freertos]
  name: SL_STACK_SIZE
  value: '4096'
- {name: configTIMER_TASK_PRIORITY, value: '53'}
- {name: configMAX_TASK_NAME_LEN, value: '30'}
ui_hints: {}

